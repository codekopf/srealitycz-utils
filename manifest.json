{
  "manifest_version": 3,
  "name": "Sreality Utility Google Chrome Extension",
  "version": "1.7.0",
  "description": "Shows sreality.cz prices in EUR, USD and other currencies, areas in ft², up to 5000 listings per page and a mortgage calculator.",
  "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"},
  "permissions": ["storage"],
  "host_permissions": ["https://api.cnb.cz/*", "https://open.er-api.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.sreality.cz/*"],
      "js": ["content.js"]
    }
  ]
}
