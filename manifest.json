{
  "manifest_version": 3,
  "name": "Sreality Utility Google Chrome Extension",
  "version": "1.5.0",
  "description": "Shows sreality.cz prices in EUR, USD or other currencies at the daily exchange rate, areas in m² or ft², and up to 500 listings per page.",
  "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"},
  "permissions": ["storage"],
  "host_permissions": ["https://api.cnb.cz/*", "https://open.er-api.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.sreality.cz/*"],
      "js": ["content.js"]
    }
  ]
}
